# ----------------------------------------------------------------------------
# PlanWork — Environment variables
# Copy this file to .env.local and fill in real values. NEVER commit secrets.
# ----------------------------------------------------------------------------

# Supabase project — required (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — server only, NEVER expose to the browser.
# Used by admin server actions that need to bypass RLS (e.g. listing all users).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where users are redirected after auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional UI generation (21st.dev / Magic Chat / Magic MCP).
# Only used at dev time, never required in production.
TWENTY_FIRST_API_KEY=
MAGIC_MCP_API_KEY=
MAGIC_CHAT_API_KEY=
